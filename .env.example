# Application
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Shared secret for /api/inference/*. The GPU inference worker (or Colab)
# reaches these over a public tunnel, so they cannot rely on a browser session.
INFERENCE_API_KEY=replace-with-a-long-random-secret

# Cloudflare Realtime application + TURN credentials.
CF_APP_ID=
CF_APP_SECRET=
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# Sampling window, confidence thresholds, RF-DETR tunables, and FIFO pairing
# config live in the system_settings DB table, editable at /settings/pipeline
# — see supabase/migrations/012_system_settings.sql and
# lib/inference/constants.ts. Not here: only secrets/connection info belong
# in .env.
