# Application
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/spraycount
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# Edge inference
CONFIDENCE_THRESHOLD=0.85
ACTIVE_SESSION_ID=demo-session
CONVEYOR_TRAVEL_SECONDS=3
SPINDLE_GAP_SECONDS=5
TARGET_FPS=30

# Roboflow WebRTC workflow inference
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=replace-with-rotated-roboflow-api-key
ROBOFLOW_WORKSPACE=spray-counting
ROBOFLOW_WORKFLOW=detect-count-and-visualize-2
ROBOFLOW_IMAGE_INPUT=image
ROBOFLOW_STREAM_OUTPUTS=output_image
ROBOFLOW_DATA_OUTPUTS=count_objects,predictions
ROBOFLOW_PROCESSING_TIMEOUT=3600
ROBOFLOW_REQUESTED_PLAN=webrtc-gpu-medium
ROBOFLOW_REQUESTED_REGION=us
ROBOFLOW_STREAM_SOURCE_MODE=video
ROBOFLOW_STREAM_SOURCE_URL=services/edge/data/test_videos/cam01.mp4
ROBOFLOW_STREAM_CAMERA_ID=CAM-01
ROBOFLOW_MJPEG_BIND_HOST=127.0.0.1
ROBOFLOW_MJPEG_PORT=8081

# MediaMTX RTSP router
MEDIAMTX_RTSP_BASE_URL=rtsp://mediamtx:8554
MTX_RTSPTRANSPORTS=tcp
MTX_WEBRTCADDITIONALHOSTS=127.0.0.1
MEDIAMTX_BIND_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_WEBRTC_UDP_PORT=8189

# Cameras and dashboard MJPEG stream
ESP32_HOST=http://localhost:8080
MJPEG_BIND_HOST=127.0.0.1
MJPEG_PORT=8080
CAMERA_IDS=CAM-01,CAM-02,CAM-03,CAM-04
CAMERA_SOURCES=
CAM_01_SOURCE=rtsp://mediamtx:8554/CAM-01
CAM_02_SOURCE=rtsp://mediamtx:8554/CAM-02
CAM_03_SOURCE=rtsp://mediamtx:8554/CAM-03
CAM_04_SOURCE=rtsp://mediamtx:8554/CAM-04

# Grafana
GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-local-password
GF_SECURITY_ALLOW_EMBEDDING=true
