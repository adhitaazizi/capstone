# services/inference/.env — GPU inference worker configuration.
#
# What does NOT belong here anymore: detection confidence, max detections,
# class filter, and inference resolution. Those are genuinely tunable, but
# Next.js's system_settings table (editable at /settings/pipeline) already
# owns them and serves them to this worker per-request via
# GET /api/inference/source — an .env copy here would just be a second,
# driftable source of truth for the same value. See config.py's
# FALLBACK_CONFIDENCE / FALLBACK_MAX_DETECTIONS / FALLBACK_TARGET_CLASS_NAMES
# / FALLBACK_INFERENCE_SHAPE for the (hardcoded, not env-backed) values used
# only when that block is unavailable.
#
# What DOES belong here: secrets, connection info, and RF-DETR engine
# internals that have no Next.js Settings equivalent (Next.js's settings
# cover the sampling pipeline — spindle boundaries, windowing, FIFO pairing —
# not this worker's inference engine). This worker runs as a Docker
# container, so an .env change + restart is much cheaper to iterate on than
# a code edit + CUDA image rebuild.
#
# Copy this file to services/inference/.env and fill in the values. Several
# of these already live in the project root .env (CF_APP_SECRET,
# INFERENCE_API_KEY, CF_TURN_KEY_ID/TOKEN) — python-dotenv walks up from this
# directory, so if this file is absent or leaves a value blank, the root
# .env's value is used instead. Create this file only when this worker runs
# on a separate machine from nextjs (e.g. its own RunPod pod) and needs its
# own values.

# --- Connection ---

# Not a secret, but required: how this worker finds Next.js to discover
# camera sessions, fetch tuning params, and report detections back.
#   - Same Docker network as nextjs (docker compose --profile inference):
#     http://nextjs:3000
#   - A separate machine (its own RunPod pod, a workstation): the public URL
#     Next.js is reachable at.
NEXTJS_BASE_URL=http://localhost:3000

# --- Secrets ---

# Shared secret for /api/inference/*. Must match the value nextjs reads.
INFERENCE_API_KEY=

# Cloudflare Realtime app secret — same value as CF_APP_SECRET in the
# project root .env. The App ID itself is NOT set here: it is discovered
# from Next.js's registered source sessions, so this worker can never drift
# onto a different Cloudflare application than the browser publisher it
# needs to subscribe to.
CF_APP_SECRET=

# TURN relay credentials (optional) — needed only if this worker's network
# cannot connect on STUN alone.
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# --- RF-DETR engine internals (no Next.js Settings equivalent) ---

# Path to the trained RF-DETR Medium checkpoint. Relative paths resolve
# against the repository root, so the default below means
# <repo root>/weights/checkpoint_best_total.pth — see weights/README.md.
CHECKPOINT_PATH=weights/checkpoint_best_total.pth
# Only enable for a checkpoint you created or fully trust — .pth files can
# contain arbitrary pickled Python objects.
TRUST_CHECKPOINT=true

OPTIMIZE_FOR_INFERENCE=true
OPTIMIZE_COMPILE=false
OPTIMIZE_INPLACE=true
USE_HALF_PRECISION=true

# How often buffered detections are POSTed to Next.js, and how many frames
# are buffered before the oldest are dropped (see reporter.py).
REPORT_FLUSH_SECONDS=0.5
REPORT_BUFFER_MAXLEN=200

# Fail fast if no CUDA GPU is visible. Set to false only to force (much
# slower) CPU inference, e.g. for a quick smoke test.
REQUIRE_CUDA=true

# --- Advanced / rarely needed ---
# Leave these blank unless you know you need them.

# Force a specific Cloudflare App ID instead of discovering it from Next.js.
# Only meaningful together with MANUAL_SOURCE_COORDINATES below.
CF_APP_ID_OVERRIDE=

# Hand-supplied camera sessions (JSON or ENV block), used only when Next.js
# is unreachable and sessions must be supplied without auto-discovery. Leave
# empty to auto-discover. See discovery.parse_source_coordinates.
MANUAL_SOURCE_COORDINATES=
