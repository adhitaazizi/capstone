# services/inference/.env — GPU inference worker configuration.
#
# Copy this file to services/inference/.env and fill in the values. Several
# of these already live in the project root .env for the edge worker
# (CF_APP_SECRET, INFERENCE_API_KEY, CF_TURN_KEY_ID/TOKEN) — python-dotenv
# walks up from this directory, so if this file is absent or leaves a value
# blank, the root .env's value is used instead. Create this file only to
# override something for the specific machine running this worker.

# Reachable from wherever this worker runs.
#   - Same Docker network as nextjs (docker compose --profile inference):
#     http://nextjs:3000
#   - A separate GPU machine (a rented GPU box, a workstation not on the
#     compose network): the cloudflared tunnel URL from
#     `cloudflared tunnel --url http://localhost:3000` — see
#     capstone_inference.ipynb section 2b / CLAUDE.md for why a tunnel is
#     needed there.
NEXTJS_BASE_URL=http://localhost:3000

# Shared secret for /api/inference/*. Must match the value nextjs reads.
INFERENCE_API_KEY=

# Cloudflare Realtime app secret — same value as CF_APP_SECRET in the
# project root .env. The App ID itself is NOT set here: it is discovered
# from Next.js's registered source sessions, so this worker can never drift
# onto a different Cloudflare application than the edge worker it needs to
# subscribe to. Only set CF_APP_ID_OVERRIDE to force a specific one (e.g.
# MANUAL_SOURCE_COORDINATES below is also being used).
CF_APP_SECRET=
CF_APP_ID_OVERRIDE=

# TURN relay credentials (optional) — the same pair the edge worker uses.
# Needed only if this worker's network cannot connect on STUN alone (see
# services/edge/run-native.ps1 for the concrete case this project hit).
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# Path to the trained RF-DETR Medium checkpoint. Relative paths resolve
# against the repository root, so the default below means
# <repo root>/weights/checkpoint_best_total.pth — see weights/README.md.
CHECKPOINT_PATH=weights/checkpoint_best_total.pth
# Only enable for a checkpoint you created or fully trust — .pth files can
# contain arbitrary pickled Python objects.
TRUST_CHECKPOINT=true

CONFIDENCE=0.35
MAX_DETECTIONS=100
# Comma-separated checkpoint class names to keep; leave empty to keep every
# class the checkpoint exposes.
TARGET_CLASS_NAMES=
# "HEIGHT,WIDTH". Leave empty to use the resolution stored by the checkpoint.
INFERENCE_SHAPE=

OPTIMIZE_FOR_INFERENCE=true
OPTIMIZE_COMPILE=false
OPTIMIZE_INPLACE=true
USE_HALF_PRECISION=true

# How often buffered detections are POSTed to Next.js, and how many frames
# are buffered before the oldest are dropped (see reporter.py).
REPORT_FLUSH_SECONDS=0.5
REPORT_BUFFER_MAXLEN=200

# Fallback source-camera coordinates (JSON or ENV block), used only when
# Next.js is unreachable and the edge worker's sessions must be supplied by
# hand. Leave empty to auto-discover. See discovery.parse_source_coordinates.
MANUAL_SOURCE_COORDINATES=

# Fail fast if no CUDA GPU is visible. Set to false only to force (much
# slower) CPU inference, e.g. for a quick smoke test.
REQUIRE_CUDA=true
